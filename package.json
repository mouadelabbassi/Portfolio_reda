{
  "name": "me-signal-portfolio",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/validate-graph.mjs && node --test",
    "perf": "node scripts/perf-check.mjs --report",
    "deploy": "pnpm run check && pnpm run build && wrangler deploy"
  },
  "dependencies": { "three": "0.180.0" },
  "devDependencies": { "vite": "6.1.0", "wrangler": "4.45.0" }
}
